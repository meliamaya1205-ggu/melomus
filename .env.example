# Variables de Entorno para Supabase (Producción / Desarrollo)
# Reemplaza estos valores con los provistos en tu panel de Supabase:
# https://supabase.com/dashboard/project/_/settings/api

# URL de la instancia de Supabase (Pública)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Llave pública anónima de Supabase con RLS habilitado (Pública y segura para el navegador)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
